# SIMRS Web — konfigurasi Apache (XAMPP)
# Selalu arahkan ke index.php sehingga akses "localhost/SIMRS" langsung bekerja.
DirectoryIndex index.php

# Lindungi folder database & berkas sensitif dari akses web
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)database/ - [F,L]
    RewriteRule \.(sql|lock|log)$ - [F,L]
</IfModule>

# Charset bawaan
AddDefaultCharset UTF-8
