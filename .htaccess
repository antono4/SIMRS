# SIMRS Web — konfigurasi Apache (XAMPP)
# Aplikasi memakai index.php?page=..., sehingga tidak wajib rewrite.
# Blok akses langsung ke berkas sensitif.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|lock|log|md)$">
    Require all denied
</FilesMatch>

# Lindungi folder database dari akses web
RedirectMatch 403 ^.*/database/.*$

# Halaman default
DirectoryIndex index.php

# Charset bawaan
AddDefaultCharset UTF-8
